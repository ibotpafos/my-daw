{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "My DAW project command batch v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "commandId", "projectId", "expectedRevision", "operations"],
  "properties": {
    "apiVersion": {"const": 0},
    "commandId": {"$ref": "#/$defs/id"},
    "projectId": {"$ref": "#/$defs/id"},
    "expectedRevision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "trackId", "name"],
            "properties": {
              "type": {"const": "track.rename"},
              "trackId": {"$ref": "#/$defs/id"},
              "name": {"type": "string", "minLength": 1, "maxLength": 120}
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "trackId", "gainDb"],
            "properties": {
              "type": {"const": "track.setGain"},
              "trackId": {"$ref": "#/$defs/id"},
              "gainDb": {"type": "number", "minimum": -120, "maximum": 24}
            }
          }
        ]
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"}}
}
